# Copy to .env and fill in real values. .env.example is committed on purpose
# (it documents required configuration); .env itself is gitignored and must
# never contain real secrets in version control.

# ---- Supabase (server) ----
SUPABASE_PROJECT_ID=replace-me
SUPABASE_PUBLISHABLE_KEY=replace-me
SUPABASE_URL=https://example.invalid

# ---- Supabase (browser, exposed by Vite) ----
VITE_SUPABASE_PROJECT_ID=replace-me
VITE_SUPABASE_PUBLISHABLE_KEY=replace-me
VITE_SUPABASE_URL=https://example.invalid

# ---- Payments / catalog / project ----
VITE_PAYMENT_CHECKOUT_URL=https://example.invalid
VITE_CATALOG_API_URL=https://example.invalid
VITE_PROJECT_ID=replace-me

# ---- Server settings (set as secrets in AI Studio; never commit real values) ----
# Public address of the live site. Used in email links; must be your real https address.
APP_ORIGIN=https://replace-me.example.com
# Random strings, 32+ characters each.
EMBED_SIGNING_SECRET=replace-me
CRON_SECRET=replace-me
PAYMENT_WEBHOOK_SECRET=replace-me
# HighLevel private integration token (orders read, contacts write, conversation messages
# write, invoices write) and your HighLevel location id.
HL_API_TOKEN=replace-me
HL_LOCATION_ID=replace-me
# Casual participant overage invoicing: off unless set to "on". Invoices are drafts unless
# OVERAGE_INVOICING_LIVE is also "on". HL_INVOICE_USER_ID is a HighLevel user id.
OVERAGE_INVOICING=off
OVERAGE_INVOICING_LIVE=off
HL_INVOICE_USER_ID=replace-me
# Organiser CRM connections (Phase 1.2). 32 random bytes, base64: openssl rand -base64 32
# Needed before an organiser can connect HighLevel; connection tokens are encrypted with it.
CRM_ENCRYPTION_KEY=replace-me

# Optional. Comma separated emails that are always treated as system owner. If unset, the
# earliest account created in Klokk becomes the system owner the first time they sign in.
SYSTEM_OWNER_EMAILS=
